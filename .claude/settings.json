{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/triage-enforce.sh",
            "timeout": 10,
            "statusMessage": "Checking triage authorization..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f .claude/triage.lock",
            "async": true
          }
        ]
      }
    ]
  }
}